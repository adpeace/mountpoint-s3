; Replay an interleaved multi-cursor read sequence through a single file descriptor.
;
; A single job (NOT numjobs) so every read reaches one open fd and therefore one Mountpoint
; prefetcher request -- the only way multi-cursor tracking engages (see gen_interleaved_iolog.py).
; The read sequence lives in the iolog generated by gen_interleaved_iolog.py (IOLOG); replay_redirect
; points every replayed read at the actual mounted file (REPLAY_TARGET). Redirect is used rather than
; --directory because fio 3.32 segfaults replaying a version-2 iolog with a relative filename against
; --directory; an absolute redirect target avoids that path entirely and keeps the iolog
; mount-agnostic. Both IOLOG and REPLAY_TARGET are set by the harness (fio_benchmark.py).
[global]
name=multi_cursor
ioengine=psync
thread
group_reporting
; direct=1 bypasses the kernel page cache so the exact iolog offsets/sizes reach FUSE. With
; buffered reads (direct=0) kernel readahead coalesces the replayed reads before they reach the
; prefetcher, so the read_size/visit granularity is reshaped and can differ between A/B arms. Fed
; from benchmarks.fio.direct_io by the harness (fio_benchmark.py), same as the other jobs.
direct=${DIRECT}
; Wall-clock cap (from config.yaml run_time, via RUN_TIME) matching the other jobs. read_iolog does
; NOT loop -- it stops at end-of-log regardless of time_based -- so RUN_TIME acts purely as a
; ceiling: a fast arm (multi-cursor) finishes the replay and stops early; a slow arm (single-cursor
; thrashing an interleaved workload) rides the full cap. Set RUN_TIME >= the fast arm's completion
; time so both arms are compared over at least equal wall-clock.
runtime=${RUN_TIME}
time_based

[multi_cursor]
read_iolog=${IOLOG}
replay_redirect=${REPLAY_TARGET}

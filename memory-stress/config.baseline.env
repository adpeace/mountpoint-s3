# Baseline configuration: effectively unconstrained memory target, used to
# establish the workload's natural peak memory demand and confirm that it
# would exceed the constrained target (2048 MiB). Same workload scale as the
# full run but shorter phases -- we only need the peak, not an hour of it.

S3_BUCKET=adpeace-mountpoint-perf-test
S3_PREFIX=memlimit-test/

# 32 GiB: far above what this workload demands, so the limiter never binds.
MEMORY_TARGET_MIB=32768

READ_PART_SIZE=8388608
WRITE_PART_SIZE=8388608
MAX_THREADS=16

# Same dataset as the full run (reused across runs via size/.ready checks).
READ_POOL_COUNT=32
READ_OBJECT_SIZE_MIB=1024

READDIR_DIRS=200
READDIR_FILES_PER_DIR=200
READDIR_FILE_SIZE_BYTES=4096

# Shorter phases: enough to reach steady-state peak demand per phase.
PHASE_SECS=180

SEQ_READERS=24
RAND_READERS=32
WRITERS=16
SLOW_READ_RATE=1m
SLOW_READERS=24

SAMPLE_INTERVAL_SECS=1
STALL_TIMEOUT_SECS=120

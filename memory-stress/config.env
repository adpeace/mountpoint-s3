# Memory-limiter stress test configuration.
#
# This file is the reproducible unit: a run is fully determined by these
# values plus the mountpoint-s3 commit. To reproduce a breaking run, keep
# this file and re-invoke run.sh.

# --- S3 target -------------------------------------------------------------
# Bucket and prefix the mount is pointed at. The prefix must be writable.
S3_BUCKET=adpeace-mountpoint-perf-test
S3_PREFIX=memlimit-test/

# --- Memory limit ----------------------------------------------------------
# Passed to mount-s3 as --memory-target (MiB). The primary constrained run
# uses a moderate limit well below the workload's natural peak. Set to a
# large value (e.g. 32768) for the unconstrained baseline run.
MEMORY_TARGET_MIB=2048

# --- Mount options ---------------------------------------------------------
READ_PART_SIZE=8388608     # 8 MiB
WRITE_PART_SIZE=8388608    # 8 MiB
MAX_THREADS=16

# --- Read dataset (pre-created once, reused across runs) --------------------
# A pool of large objects the readers stream. Total = READ_POOL_COUNT *
# READ_OBJECT_SIZE_MIB. READ_POOL_COUNT must be >= the largest per-phase
# reader count (each fio job reads read_<jobnum>.bin), so every reader maps
# to a real file. Sized so many concurrent readers demand more buffer than
# MEMORY_TARGET_MIB.
READ_POOL_COUNT=32
READ_OBJECT_SIZE_MIB=1024  # 1 GiB each -> 32 GiB pool

# --- readdir dataset -------------------------------------------------------
# A wide/deep tree of small objects to exercise metadata memory. Created
# once via the mount, reused across runs.
READDIR_DIRS=200
READDIR_FILES_PER_DIR=200
READDIR_FILE_SIZE_BYTES=4096

# --- Workload phases -------------------------------------------------------
# Each phase runs for PHASE_SECS. Concurrency per phase is set in workload.sh.
# Total run >= sum of phase durations. Default: 6 phases * 600s = 3600s (1h).
PHASE_SECS=600

# Per-phase worker counts (see workload.sh for how each phase composes these).
SEQ_READERS=24            # parallel sequential readers
RAND_READERS=32           # parallel random readers
WRITERS=16                # parallel sequential writers
SLOW_READ_RATE=1m         # per-thread rate cap for the "slow read" phase (fio --rate)
SLOW_READERS=24

# --- Sampling --------------------------------------------------------------
SAMPLE_INTERVAL_SECS=1

# --- Watchdog --------------------------------------------------------------
# If the mount's RSS sample cannot be taken (process gone) or a phase's fio
# makes no progress for this long, the driver records it and moves on.
STALL_TIMEOUT_SECS=120

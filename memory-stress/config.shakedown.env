# Shakedown configuration: short phases and a small dataset to validate the
# harness end-to-end (mount, sampling, phases, teardown) before committing to
# a full-length run. NOT a real test -- durations are far too short to draw
# conclusions. Keeps the same 2 GiB target so we can confirm the workload
# already pressures the limit at reduced scale.

S3_BUCKET=adpeace-mountpoint-perf-test
S3_PREFIX=memlimit-test/

MEMORY_TARGET_MIB=2048

READ_PART_SIZE=8388608
WRITE_PART_SIZE=8388608
MAX_THREADS=16

# Small dataset so prepare is quick. Pool count still >= max reader count.
READ_POOL_COUNT=16
READ_OBJECT_SIZE_MIB=512    # 512 MiB each -> 8 GiB pool

READDIR_DIRS=20
READDIR_FILES_PER_DIR=50
READDIR_FILE_SIZE_BYTES=4096

# Short phases: ~30s each, 6 phases -> ~3 min of workload.
PHASE_SECS=30

SEQ_READERS=16
RAND_READERS=16
WRITERS=8
SLOW_READ_RATE=1m
SLOW_READERS=16

SAMPLE_INTERVAL_SECS=1
STALL_TIMEOUT_SECS=60
